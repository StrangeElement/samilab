# Copy this file to .env.deploy (ignored by Git, chmod 600) and fill in your
# production web hosting details. Used only by scripts/deploy-whc.sh
# (NAS -> production sync). The local dev NAS uses standard SSH (port 22).
WHC_USER="your_cpanel_username"
WHC_HOST="your_server_hostname"
WHC_PORT="your_hosting_ssh_port"
